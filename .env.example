# ─── LLM Providers ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxx
OPENAI_API_KEY=sk-xxxxx
GOOGLE_API_KEY=xxxxx

# ─── Databases ─────────────────────────────────────────────────
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexusai?schema=public
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexuspass
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Kafka ─────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nexusai

# ─── Services ──────────────────────────────────────────────────
ORCHESTRATOR_PORT=4000
ORCHESTRATOR_URL=http://localhost:4000
RAG_PORT=5000
RAG_URL=http://localhost:5000

# ─── Evals service (agent regression testing) ───────────────
EVALS_PORT=5100
EVALS_URL=http://localhost:5100
EVAL_CONCURRENCY=4
AGENT_RUN_TIMEOUT_S=300
JUDGE_MODEL=gemini-1.5-pro

# ─── Shared model config (rag + evals) ──────────────────────
REASONING_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-3-small
WEB_PORT=3000

# ─── Auth ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-please
NEXTAUTH_SECRET=change-me-too
NEXTAUTH_URL=http://localhost:3000

# ─── Observability ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info

# ─── Manager service (dynamic multi-agent) ──────────────────
MANAGER_PORT=4100
MANAGER_URL=http://localhost:4100
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=llama3:8b
OLLAMA_PLANNER_MODEL=llama3:8b
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-5
OPENAI_DEFAULT_MODEL=gpt-4o
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
# Search runs without a key by default. Set TAVILY_API_KEY to use Tavily instead.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SANDBOX_URL=http://localhost:4500
# Budget caps, enforced in code
MAX_TOTAL_TOKENS=200000
MAX_USD=1.00
MAX_AGENTS_SPAWNED=8
MAX_DEPTH=2
WORKER_TIMEOUT_S=90
# Tracing (opt-in)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=nexus-manager
